# AIR Blackbox Gate — Environment Variables

# REQUIRED: Secret key for signing events (use a strong random string).
# Used for the default HMAC-SHA256 audit chain.
GATE_SIGNING_KEY=change-me-use-a-real-secret-key

# OPTIONAL: asymmetric signing. With Ed25519, auditors verify the chain using
# only the public key and cannot forge it. Generate a keypair with:
#   air-gate keygen
# GATE_SIGNATURE_ALGORITHM=Ed25519
# GATE_ED25519_PRIVATE_HEX=...   # 32-byte hex seed; signs the chain (keep secret)
# GATE_ED25519_PUBLIC_HEX=...    # optional; auditors use this to verify

# STRONGLY RECOMMENDED: Bearer token required to call the approve/reject API.
# If unset, /actions/{id}/approve and /reject are UNAUTHENTICATED - anyone who
# can reach the server can approve or reject as any human. Callers must send
# `Authorization: Bearer <this value>`.
GATE_APPROVAL_TOKEN=change-me-use-a-real-approver-token

# OPTIONAL: Slack integration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# OR use bot token for full interactivity:
# SLACK_BOT_TOKEN=xoxb-your-bot-token
# SLACK_CHANNEL=#ai-approvals
# REQUIRED for Slack button approvals: the app's Signing Secret. Without it,
# /slack/interact refuses all requests (it cannot verify they came from Slack).
# SLACK_SIGNING_SECRET=your-slack-signing-secret

# OPTIONAL: Override defaults
# GATE_STORAGE_PATH=gate_events.jsonl
# GATE_CONFIG_PATH=gate_config.yaml
# GATE_URL=http://localhost:8000
