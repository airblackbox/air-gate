# AIR Blackbox Gate — Environment Variables

# REQUIRED: Secret key for signing events (use a strong random string)
GATE_SIGNING_KEY=change-me-use-a-real-secret-key

# OPTIONAL: Slack integration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# OR use bot token for full interactivity:
# SLACK_BOT_TOKEN=xoxb-your-bot-token
# SLACK_CHANNEL=#ai-approvals

# OPTIONAL: Override defaults
# GATE_STORAGE_PATH=gate_events.jsonl
# GATE_CONFIG_PATH=gate_config.yaml
# GATE_URL=http://localhost:8000
